---
import Layout from "@layouts/Layout.astro";

// En un sitio estático el 404.html es único para toda URL desconocida, así que
// el idioma se decide en el cliente según la ruta (/en/... → inglés, resto → español).
const copy = {
  es: {
    title: "Página no encontrada",
    text: "La página que buscas no existe o fue movida.",
    cta: "Volver al inicio",
    href: "/",
  },
  en: {
    title: "Page not found",
    text: "The page you are looking for doesn't exist or has been moved.",
    cta: "Back to home",
    href: "/en/",
  },
} as const;
const langs = Object.keys(copy) as Array<keyof typeof copy>;
---

<Layout
  title="404 · Santiago C."
  description="404 - Página no encontrada / Page not found"
  showLogo={false}
>
  <main class="px-6 md:px-5 grow flex items-center justify-center">
    {
      langs.map((code) => (
        <section
          data-lang={code}
          hidden={code !== "es"}
          class="flex flex-col items-center text-center gap-5 py-20"
        >
          <img
            src="https://http.cat/404.jpg"
            alt="HTTP 404 cat"
            width="750"
            height="600"
            loading="eager"
            class="w-full max-w-md rounded-2xl shadow-xl ring-2 ring-sky-800 dark:ring-gray-400"
          />
          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-gray-800 dark:text-slate-200">
            {copy[code].title}
          </h1>
          <p class="text-pretty text-xl text-gray-800 dark:text-gray-300">
            {copy[code].text}
          </p>
          <a
            href={copy[code].href}
            class="mt-3 inline-flex items-center justify-center px-4 py-2 text-base text-gray-800 border border-gray-300 rounded-xl dark:text-white dark:bg-gray-800 dark:border-gray-600 hover:text-sky-700 dark:hover:text-yellow-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:scale-103 transition focus:outline-none focus-visible:ring focus-visible:ring-offset-2 focus-visible:ring-yellow-500/80"
          >
            {copy[code].cta}
          </a>
        </section>
      ))
    }
  </main>
</Layout>

<script>
  const lang = /^\/en(\/|$)/.test(location.pathname) ? "en" : "es";
  document.documentElement.lang = lang;
  document.querySelectorAll<HTMLElement>("[data-lang]").forEach((el) => {
    el.hidden = el.dataset.lang !== lang;
  });
</script>
