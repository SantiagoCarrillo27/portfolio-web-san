---
import ThemeToggle from "./ThemeToggle.astro";
import LanguagePicker from "./LanguagePicker.astro";
---

<header
  class="sticky top-0 flex justify-between items-center bg-opacity-80 dark:bg-opacity-80 backdrop-blur-lg px-6 md:px-5 py-2 z-50"
>
  <div
    id="logoText"
    class="flex items-center justify-center gap-x-3 translate-y-15 opacity-0 transition-all duration-300"
  >
    <div
      class="w-13 h-13 shrink-0 overflow-hidden cursor-pointer bg-sky-100 rounded-full border-3 dark:border-4 border-white shadow-lg dark:border-gray-900/90 dark:bg-gray-700/60"
    >
      <img
        src="/card/Avatar_xantidev_nobg.png"
        alt="xantidev"
        class="size-full object-cover"
      />
    </div>
    <h1
      class="text-md transition-all md:text-xl font-semibold whitespace-nowrap text-black/80 dark:text-slate-200"
    >
      Santiago <span class="hidden md:inline">Carrillo</span><span class="md:hidden">C.</span>
    </h1>
  </div>

  <nav class="flex items-center justify-end">
    <LanguagePicker />
    <ThemeToggle />
  </nav>
</header>

<script>
  const logoText = document.getElementById("logoText");

  document.addEventListener("DOMContentLoaded", () => {
    window.addEventListener("scroll", () => {
      if (logoText) {
        const threshold = window.matchMedia("(min-width: 768px)").matches ? 310 : 150;
        if (window.scrollY > threshold) {
          logoText.classList.remove("translate-y-15", "opacity-0");
        } else {
          logoText.classList.add("translate-y-15", "opacity-0");
        }
      }
    });
  });
</script>
