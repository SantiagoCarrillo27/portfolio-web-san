---
import Decoration from "@components/Decoration.astro";
import BriefcaseIcon from "@components/icons/BriefcaseIcon.astro";
import { getLang, useTranslations } from "@i18n/utils";

const lang = getLang(Astro);
const t = useTranslations(lang);
---

<main class="flex flex-col md:flex-row items-center md:justify-start gap-7 mb-23 md:mb-32 md:mt-19 transition-discrete">
  <div
    class="w-32 md:w-64 shrink-0 aspect-square overflow-hidden bg-sky-100 rounded-full border-6 border-white shadow-xl dark:border-gray-900/80 dark:bg-gray-700/60"
  >
    <img
      src="/card/Avatar_xantidev_nobg.png"
      alt="xantidev"
      class="size-full object-cover"
    />
  </div>

  <div class="flex items-center md:items-start md:justify-start flex-col gap-6 md:gap-3">
    <h1
      class=" text-4xl transition-all sm:text-5xl font-semibold whitespace-nowrap text-gray-800 dark:text-slate-200 tracking-tight"
    >
      {lang === "en" ? "I'm Santiago Carrillo" : "Soy Santiago Carrillo"}
    </h1>

    <p
      class="text-pretty text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-sky-800 [&>strong]:font-semibold dark:text-gray-300"
    >
      {lang === "en" ? (
        <Fragment>
          2+ years of experience. <strong
            >Systems Engineer <small>(5th year)</small> and Web
            Application Developer <small>(VET)</small></strong>, from Colombia, <small>CO</small>. Expert in
          building innovative and functional web experiences.
        </Fragment>
      ) : (
        <Fragment>
          +3 años de experiencia. <strong
            >Ingeniero de Sistemas <small>(5º año)</small> y Desarrollador de
            Aplicaciones Web <small>(FP)</small></strong>, de Colombia, <small>CO</small>. Experto en la creación de
          experiencias web innovadoras y funcionales.
        </Fragment>
      )}
    </p>

    <a
      href="https://www.linkedin.com/in/santiagocarrillo27/"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition-all md:justify-start md:hover:scale-105 w-fit"
    >
      <Decoration
        >{t("main.available")}<BriefcaseIcon class="size-6 pl-1" /></Decoration
      >
    </a>
  </div>


</main>
