---
import ExperienceItem from "./ExperienceItem.astro"
import { EXPERIENCE } from "@util/Experience";
import { getLang } from "@i18n/utils";

const lang = getLang(Astro);
---

<ol class="relative mt-14 mb-20">
  {
    EXPERIENCE.map(({ date, title, company, description, link }, index) => (
      <li class="">
        <ExperienceItem
          date={date[lang]}
          title={title[lang]}
          company={company}
          description={description[lang]}
          link={link}
          isLatest={index === 0}
        />
      </li>
    ))
  }
</ol>

