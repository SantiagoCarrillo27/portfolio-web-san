---
import GitHubIcon from "./icons/GitHub.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import MailContactIcon from "./icons/MailContactIcon.astro";
import { getLang, useTranslations } from "@i18n/utils";

const t = useTranslations(getLang(Astro));
const currentYear = new Date().getFullYear();
---

<div class="flex justify-between items-center py-9">
  <h1 class="text-gray-800 dark:text-white text-center p-4">
    &copy; <span>{currentYear}</span> 
  </h1>

  <span class="text-gray-800 dark:text-white">Santiago ❤️.</span>

  <div
    class="flex justify-center items-center gap-x-3 md:gap-x-6 [&>a]:text-gray-800 dark:[&>a]:text-white"
  >
    <a
      href="https://www.linkedin.com/in/santiagocarrillo27/"
      class="hover:scale-120 transition duration-300"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t("footer.linkedin")}
    >
      <LinkedInIcon class="size-5" />
    </a>
    <a
      href="mailto:santiagodev27@gmail.com"
      class="hover:scale-120 transition duration-300"
      rel="noopener noreferrer"
      aria-label={t("footer.mail")}
    >
      <MailContactIcon class="size-6" />
    </a>

    <a
      href="https://github.com/SantiagoCarrillo27"
      class="hover:scale-120 transition duration-300"
      rel="noopener noreferrer"
      aria-label={t("footer.github")}
    >
      <GitHubIcon class="size-5" />
    <a/>
  </div>
</div>

