---
import FlagES from "@icons/FlagES.astro";
import FlagUS from "@icons/FlagUS.astro";
import { getLang, localizedPath, useTranslations } from "@i18n/utils";
import { languages, type Lang } from "@i18n/ui";

const current = getLang(Astro);
const t = useTranslations(current);

const flags: Record<Lang, typeof FlagES> = { es: FlagES, en: FlagUS };
const options = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  label: languages[code],
  href: localizedPath(code),
  Flag: flags[code],
  active: code === current,
}));
const CurrentFlag = flags[current];
---

<!-- Selector de idioma: <details> funciona sin JS; el script solo cierra el menú al hacer clic fuera o con Escape -->
<details id="lang-picker" class="relative group mr-12">
  <summary
    aria-label={t("lang.label")}
    class="flex items-center gap-x-1.5 cursor-pointer select-none list-none rounded-lg px-2.5 py-2.5 text-sm font-semibold uppercase leading-5 text-gray-800 bg-sky-100 hover:bg-sky-200 dark:text-white dark:bg-gray-700/60 dark:hover:bg-gray-700 transition-colors duration-300 [&::-webkit-details-marker]:hidden"
  >
    <CurrentFlag class="size-5 rounded-sm shadow-sm" />
    <span class="hidden sm:inline">{current}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
      class="size-4 transition-transform duration-300 group-open:rotate-180"
    >
      <path
        fill-rule="evenodd"
        d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
        clip-rule="evenodd"></path>
    </svg>
  </summary>

  <ul
    class="absolute right-0 top-full mt-2 min-w-28 p-1 rounded-lg border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-900 z-50"
  >
    {
      options.map(({ code, label, href, Flag, active }) => (
        <li>
          <a
            href={href}
            hreflang={code}
            lang={code}
            title={label}
            aria-current={active ? "page" : undefined}
            class={`flex items-center gap-x-2 rounded-md px-2.5 py-2 text-sm font-semibold uppercase transition-colors ${
              active
                ? "bg-sky-100 text-sky-800 dark:bg-gray-700 dark:text-yellow-300"
                : "text-gray-800 hover:bg-sky-50 dark:text-white dark:hover:bg-gray-800"
            }`}
          >
            <Flag class="size-5 rounded-sm shadow-sm" />
            {code}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  const picker = document.getElementById("lang-picker") as HTMLDetailsElement | null;

  if (picker) {
    document.addEventListener("click", (event) => {
      if (picker.open && !picker.contains(event.target as Node)) {
        picker.open = false;
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && picker.open) {
        picker.open = false;
        picker.querySelector("summary")?.focus();
      }
    });
  }
</script>
