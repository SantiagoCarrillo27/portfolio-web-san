---
import "../styles/global.css";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import "@fontsource-variable/golos-text";
import { getLang, localizedPath } from "@i18n/utils";
import { languages, defaultLang } from "@i18n/ui";

interface Props {
  title: string;
  description: string;
  showLogo?: boolean;
  noindex?: boolean;
}

const { title, description, showLogo = true, noindex = false } = Astro.props;
const lang = getLang(Astro);
// hreflang necesita URLs absolutas: solo se emite si `site` está definido en astro.config.mjs
const base = Astro.site;
const canonical = base ? new URL(Astro.url.pathname, base).href : undefined;
const ogImage = base ? new URL("/profile.webp", base).href : undefined;
const ogLocale = lang === "es" ? "es_ES" : "en_US";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Santiago Carrillo",
  url: base?.href,
  image: ogImage,
  jobTitle: lang === "es" ? "Desarrollador Web" : "Web Developer",
  description,
  sameAs: [
    "https://www.linkedin.com/in/santiagocarrillo27/",
    "https://github.com/SantiagoCarrillo27",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {
      base &&
        Object.keys(languages).map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={new URL(localizedPath(code as keyof typeof languages), base).href}
          />
        ))
    }
    {
      base && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localizedPath(defaultLang), base).href}
        />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Santiago Carrillo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body class="relative text-black dark:text-white min-h-screen">
    <!-- BACKGROUND DE TODA LA PÁGINA -->
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-white dark:bg-gray-950
     bg-[radial-gradient(100%_50%_at_50%_0%,rgba(0,163,255,0.13)_0,rgba(0,163,255,0)_50%,rgba(0,163,255,0)_100%)]
     dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <!--. -->

    <!-- min-h-dvh grid grid-rows-[auto_1fr_auto] PARA USAR CON GRID -->

    <div class="max-w-4xl mx-auto min-h-dvh flex flex-col justify-between">
      <Header showLogo={showLogo} />
      <slot />
      <Footer />
    </div>
  </body>
</html>

<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/flowbite@3.0.0/dist/flowbite.min.js"
></script>
